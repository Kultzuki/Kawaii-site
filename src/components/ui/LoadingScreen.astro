---
import Icon from '@/components/ui/Icon.astro';
---

<!-- ==========================================================================
     Hello Kitty Animated Loading Screen & Intro Portal
     Seamlessly sunk into the background with mix-blend transparency,
     compact on mobile and spacious on laptop/desktop.
     ========================================================================== -->
<div id="app-loading-screen" class="app-loading-screen" role="dialog" aria-modal="true" aria-label="Loading Hackathon Portal">
  <!-- Soft Ambient Glow & Grid Texture -->
  <div class="loader-ambient-glow" aria-hidden="true"></div>
  <div class="loader-bg-pattern" aria-hidden="true"></div>

  <!-- Safe Area Top Bar -->
  <header class="loader-top-bar">
    <div class="loader-event-badge">
      <Icon name="bow" size={14} color="var(--color-red)" />
      <span class="badge-title">HACK THE FUTURE</span>
    </div>

    <button id="btn-skip-loader" class="btn-loader-skip" type="button" aria-label="Skip Loading Intro">
      <span>Skip</span>
      <span class="skip-key-hint">ESC</span>
      <Icon name="arrow-right" size={12} />
    </button>
  </header>

  <!-- Center Stage -->
  <div class="loader-center-content">
    <div class="loader-stage" id="loader-stage">
      <!-- Sunk Seamless Video Frame -->
      <div class="loader-video-wrapper">
        <video
          id="loader-intro-video"
          src="/video/make_it_animated_like.webm"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline="true"
          preload="auto"
          class="loader-video-element"
        ></video>
      </div>

      <!-- Loading Details & Progress Bar -->
      <div class="loader-meta-wrap">
        <div class="loader-phase-tagline">
          <span class="pulse-dot"></span>
          <span id="loader-status-text" class="status-msg">
            Phase 1: Online PPT &bull; Phase 2: Campus Sprint
          </span>
        </div>

        <!-- Sleek Progress Line -->
        <div class="loader-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="loader-progress-bar">
          <div class="loader-progress-fill" id="loader-progress-fill"></div>
        </div>

        <div class="loader-bottom-row">
          <span class="type-metadata venue-hint">Tula's University &bull; ₹7 Lakhs+</span>
          <span class="loader-percent" id="loader-percent-num">0%</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function initAppLoader() {
    const screen = document.getElementById('app-loading-screen');
    const stage = document.getElementById('loader-stage');
    const fill = document.getElementById('loader-progress-fill');
    const percent = document.getElementById('loader-percent-num');
    const statusText = document.getElementById('loader-status-text');
    const skipBtn = document.getElementById('btn-skip-loader');
    const video = document.getElementById('loader-intro-video') as HTMLVideoElement | null;

    if (!screen) return;

    // Prevent background scrolling while loading
    document.body.style.overflow = 'hidden';

    let isDismissed = false;

    const messages = [
      "Phase 1: Online PPT & Idea Submission...",
      "Phase 2: 36-Hr In-Person Campus Sprint...",
      "Connecting to Tula's University, Dehradun...",
      "Loading ₹7,00,000+ Prize Pool...",
      "Welcome to Hack The Future 2026! ✨"
    ];

    let progressObj = { value: 0 };

    // Exit Timeline
    const dismissLoader = () => {
      if (isDismissed) return;
      isDismissed = true;

      const exitTl = gsap.timeline({
        onComplete: () => {
          screen.style.display = 'none';
          document.body.style.overflow = '';
          window.dispatchEvent(new CustomEvent('loader:complete'));
        }
      });

      exitTl.to(stage, {
        scale: 0.96,
        y: -18,
        opacity: 0,
        duration: 0.45,
        ease: 'power2.in'
      })
      .to(screen, {
        opacity: 0,
        duration: 0.4,
        ease: 'power2.inOut'
      }, '-=0.15');
    };

    // Animate Progress Bar smoothly from 0 to 100% over 4.4s
    const progressTl = gsap.timeline({
      onUpdate: () => {
        const val = Math.round(progressObj.value);
        if (fill) fill.style.width = `${val}%`;
        if (percent) percent.textContent = `${val}%`;

        // Update status message dynamically based on progress milestone
        if (statusText) {
          if (val < 22) statusText.textContent = messages[0];
          else if (val < 45) statusText.textContent = messages[1];
          else if (val < 68) statusText.textContent = messages[2];
          else if (val < 92) statusText.textContent = messages[3];
          else statusText.textContent = messages[4];
        }
      },
      onComplete: () => {
        // Auto-dismiss smoothly after brief pause on 100%
        gsap.delayedCall(0.55, dismissLoader);
      }
    });

    // Smooth progress interpolation
    progressTl.to(progressObj, {
      value: 100,
      duration: 4.4,
      ease: 'power1.inOut'
    });

    // Play video safely
    if (video) {
      video.play().catch(() => {
        // Autoplay fallback
      });
    }

    // Skip button listener
    skipBtn?.addEventListener('click', dismissLoader);

    // Keyboard ESC shortcut
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dismissLoader();
      }
    });

    // Safety fallback timeout: ensure screen NEVER stays stuck past 7.5 seconds
    setTimeout(() => {
      if (!isDismissed) {
        dismissLoader();
      }
    }, 7500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAppLoader);
  } else {
    initAppLoader();
  }
</script>

<style>
  /* --------------------------------------------------------------------------
     Loading Screen Overlay (Seamless Background Integration)
     -------------------------------------------------------------------------- */
  .app-loading-screen {
    position: fixed;
    inset: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    background-color: #FAF7F4;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: max(0.85rem, env(safe-area-inset-top)) max(0.85rem, env(safe-area-inset-right)) max(0.85rem, env(safe-area-inset-bottom)) max(0.85rem, env(safe-area-inset-left));
    overflow: hidden;
    user-select: none;
    box-sizing: border-box;
  }

  /* Ambient Pastel Radial Glow to sink the video seamlessly */
  .loader-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(100vw, 800px);
    height: min(80vh, 600px);
    background: radial-gradient(circle, rgba(255, 230, 240, 0.75) 0%, rgba(254, 245, 248, 0.4) 50%, transparent 75%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 1;
  }

  .loader-bg-pattern {
    position: absolute;
    inset: 0;
    background-image: url('/assets/textures/grid-paper-pattern.svg');
    opacity: 0.35;
    pointer-events: none;
    z-index: 2;
  }

  /* --------------------------------------------------------------------------
     Top Bar
     -------------------------------------------------------------------------- */
  .loader-top-bar {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    z-index: 10;
    padding: 0.2rem 0.25rem;
  }

  .loader-event-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-subtle);
  }

  .badge-title {
    font-family: var(--font-family-display);
    font-size: 0.725rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--color-text-dark);
  }

  .btn-loader-skip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-family-display);
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--color-text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--duration-fast) var(--ease-standard);
    -webkit-tap-highlight-color: transparent;
  }

  .btn-loader-skip:hover,
  .btn-loader-skip:active {
    color: var(--color-primary-pink);
    border-color: var(--color-primary-pink);
    transform: translateY(-1px);
  }

  .skip-key-hint {
    font-family: var(--font-family-mono);
    font-size: 0.6rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
  }

  @media (max-width: 480px) {
    .skip-key-hint {
      display: none;
    }
  }

  /* --------------------------------------------------------------------------
     Center Content & Stage (Mobile Compact default)
     -------------------------------------------------------------------------- */
  .loader-center-content {
    position: relative;
    z-index: 5;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.5rem 0;
  }

  .loader-stage {
    width: 100%;
    max-width: min(88vw, 360px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    transition: max-width 0.3s ease;
  }

  /* Sunk Video Container (Blends effortlessly with background) */
  .loader-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: min(28vh, 230px);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    /* Soft edge feathering so rectangular boundary melts completely */
    mask-image: radial-gradient(ellipse 96% 92% at 50% 50%, black 82%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 96% 92% at 50% 50%, black 82%, transparent 100%);
  }

  .loader-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-xl);
    /* Multiply blend mode dissolves white video backgrounds into the pastel canvas */
    mix-blend-mode: multiply;
  }

  /* --------------------------------------------------------------------------
     Metadata & Progress Bar (Mobile Default)
     -------------------------------------------------------------------------- */
  .loader-meta-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .loader-phase-tagline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary-pink);
    animation: pulse 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .status-msg {
    font-family: var(--font-family-display);
    font-size: 0.775rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .loader-progress-track {
    width: 100%;
    height: 6px;
    background-color: var(--color-primary-pink-subtle);
    border: 1px solid var(--color-border-pink);
    border-radius: var(--radius-pill);
    overflow: hidden;
    position: relative;
  }

  .loader-progress-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #FF3366 0%, #FF6688 100%);
    border-radius: var(--radius-pill);
    transition: width 0.05s linear;
    box-shadow: 0 0 10px rgba(255, 51, 102, 0.45);
  }

  .loader-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .venue-hint {
    font-size: 0.725rem;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .loader-percent {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-primary-pink);
    flex-shrink: 0;
  }

  /* --------------------------------------------------------------------------
     Laptop & Desktop Viewports (min-width: 768px): Size Bigger & Spacious
     -------------------------------------------------------------------------- */
  @media (min-width: 768px) {
    .app-loading-screen {
      padding: 2rem 3rem;
    }

    .loader-stage {
      max-width: min(85vw, 560px);
      gap: 1.15rem;
    }

    .loader-video-wrapper {
      max-height: min(48vh, 360px);
      border-radius: var(--radius-2xl);
    }

    .loader-video-element {
      border-radius: var(--radius-2xl);
    }

    .loader-meta-wrap {
      gap: 0.65rem;
    }

    .status-msg {
      font-size: 0.95rem;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
    }

    .loader-progress-track {
      height: 8px;
    }

    .venue-hint {
      font-size: 0.85rem;
    }

    .loader-percent {
      font-size: 1rem;
    }

    .badge-title {
      font-size: 0.8rem;
    }

    .btn-loader-skip {
      font-size: 0.8rem;
      padding: 0.4rem 0.85rem;
    }
  }

  @media (min-width: 1200px) {
    .loader-stage {
      max-width: 600px;
    }

    .loader-video-wrapper {
      max-height: min(50vh, 390px);
    }
  }
</style>
