---
interface Props {
  variant?: 'pink' | 'cream' | 'yellow' | 'blue' | 'dark';
  class?: string;
}

const {
  variant = 'pink',
  class: className = '',
  ...rest
} = Astro.props;

const variantClass = `pill-${variant}`;
---

<span class={`pill ${variantClass} ${className}`} {...rest}>
  <slot />
</span>
