---
import RegistrationForm from '@/components/registration/RegistrationForm';
import Pill from '@/components/ui/Pill.astro';
import Sticker from '@/components/ui/Sticker.astro';
import Icon from '@/components/ui/Icon.astro';
---

<section id="register" class="section section-registration-finale" aria-label="Hackathon Registration Portal">
  <!-- Celebratory Backdrop Ambience -->
  <div class="finale-atmosphere-bg" aria-hidden="true">
    <div class="finale-radial-glow"></div>
    <div class="finale-dots-texture"></div>
  </div>

  <div class="container container-medium finale-content-container">
    <!-- Grand Finale Visual Header -->
    <div class="finale-header" data-reveal="fade">
      <div class="finale-character-badge" data-reveal="scale">
        <div class="badge-ground-shadow"></div>
        <img
          src="/assets/characters/kitty-celebration-placeholder.svg"
          alt="Hello Kitty Celebration Ambassador"
          width="180"
          height="220"
          loading="lazy"
          class="finale-char-img"
        />
        <div class="floating-bow-badge">
          <Icon name="bow" size={28} color="var(--color-red)" />
        </div>
      </div>

      <div class="finale-pill-kicker">
        <Pill variant="pink">
          <Icon name="sparkle" size={14} color="var(--color-primary-pink)" />
          <span>The Final Destination &bull; Registrations Now Open</span>
        </Pill>
      </div>

      <h2 class="type-hero-title finale-title">
        Ready to <span class="text-pink">Build the Future?</span>
      </h2>

      <p class="type-body-lead finale-lead">
        A 36-hour national hackathon, ₹7,00,000+ in prizes, expert industry mentorship, and Tula's University campus facilities. Secure your team's entry today (2–4 builders).
      </p>

      <div class="finale-stickers-row" data-reveal-stagger>
        <Sticker variant="cream" rotation="neg-2">
          <Icon name="sparkle" size={14} color="var(--color-primary-pink)" />
          <span>₹500 / Head Entry</span>
        </Sticker>
        <Sticker variant="yellow" rotation="pos-2">
          <Icon name="trophy" size={14} color="#946800" />
          <span>₹7L+ In Prizes</span>
        </Sticker>
        <Sticker variant="blue" rotation="neg-1">
          <Icon name="users" size={14} color="var(--color-blue)" />
          <span>2 - 4 Builders</span>
        </Sticker>
      </div>
    </div>

    <!-- Registration Card Box Island -->
    <div class="registration-portal-card" data-reveal="slide">
      <div class="portal-card-header">
        <div class="header-left">
          <span class="portal-indicator-dot"></span>
          <span class="type-label portal-header-title">Official Registration Portal</span>
        </div>
        <span class="type-metadata portal-status">Open &bull; October 15 - 17, 2026</span>
      </div>

      <div class="portal-form-wrapper">
        <RegistrationForm client:visible />
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
     Registration Finale Section Container
     -------------------------------------------------------------------------- */
  .section-registration-finale {
    position: relative;
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: clamp(3.5rem, 8vw, 7rem);
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .finale-atmosphere-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .finale-radial-glow {
    position: absolute;
    bottom: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: min(1000px, 120vw);
    height: 600px;
    background: radial-gradient(circle, rgba(255, 51, 102, 0.12) 0%, rgba(255, 200, 55, 0.08) 50%, transparent 70%);
    border-radius: 50%;
    filter: blur(50px);
  }

  .finale-dots-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/textures/subtle-dots-pattern.svg');
    opacity: 0.35;
  }

  .finale-content-container {
    position: relative;
    z-index: 5;
  }

  /* --------------------------------------------------------------------------
     Header & Character Presentation
     -------------------------------------------------------------------------- */
  .finale-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 820px;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    gap: var(--space-xs);
  }

  .finale-character-badge {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1rem;
  }

  .badge-ground-shadow {
    position: absolute;
    bottom: 0;
    width: 140px;
    height: 18px;
    background: radial-gradient(ellipse at center, rgba(20, 20, 23, 0.15) 0%, transparent 70%);
    border-radius: 50%;
  }

  .finale-char-img {
    filter: drop-shadow(0 12px 28px rgba(255, 51, 102, 0.16));
  }

  .floating-bow-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    animation: finale-bow-float 3s ease-in-out infinite alternate;
  }

  @keyframes finale-bow-float {
    0% { transform: translateY(0) rotate(-6deg); }
    100% { transform: translateY(-8px) rotate(6deg); }
  }

  .finale-title {
    font-size: clamp(2.15rem, 5.5vw, 4.2rem);
    line-height: 1.08;
    margin-top: 0.5rem;
  }

  .finale-lead {
    max-width: 660px;
    margin-top: var(--space-xs);
    color: var(--color-text-body);
  }

  .finale-stickers-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  /* --------------------------------------------------------------------------
     Portal Card Frame
     -------------------------------------------------------------------------- */
  .registration-portal-card {
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    max-width: 760px;
    margin: 0 auto;
  }

  .portal-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.5rem;
    background-color: var(--color-bg);
    border-bottom: 1.5px solid var(--color-border);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .portal-indicator-dot {
    width: 10px;
    height: 10px;
    background-color: #22C55E;
    border-radius: var(--radius-pill);
    box-shadow: 0 0 8px #22C55E;
    animation: live-pulse 2s infinite;
  }

  @keyframes live-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  .portal-header-title {
    font-size: 0.825rem;
    color: var(--color-text-dark);
  }

  .portal-status {
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  .portal-form-wrapper {
    padding: clamp(1.25rem, 4vw, 3rem);
  }

  /* --------------------------------------------------------------------------
     Global styles for the React RegistrationForm island inside this section
     -------------------------------------------------------------------------- */
  :global(.reg-form-container) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.form-fields-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }

  @media (min-width: 640px) {
    :global(.form-fields-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.form-label) {
    font-family: var(--font-family-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  :global(.req-star) {
    color: var(--color-red);
  }

  :global(.opt-tag) {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  :global(.form-input),
  :global(.form-select) {
    width: 100%;
    min-height: 48px;
    padding: 0.85rem 1.1rem;
    font-family: inherit;
    font-size: 16px; /* Prevents iOS Safari input auto-zoom */
    color: var(--color-text-dark);
    background-color: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard);
  }

  :global(.form-input:focus),
  :global(.form-select:focus) {
    border-color: var(--color-primary-pink);
    box-shadow: 0 0 0 3px var(--color-primary-pink-subtle);
  }

  :global(.form-checkbox-row) {
    display: flex;
    align-items: center;
  }

  :global(.checkbox-label) {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--color-text-body);
    cursor: pointer;
  }

  :global(.form-checkbox) {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary-pink);
    margin-top: 2px;
    cursor: pointer;
  }

  :global(.form-actions-wrap) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
    width: 100%;
  }

  :global(.btn-reg-submit) {
    width: 100%;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    font-family: var(--font-family-display);
    font-size: clamp(1rem, 2.5vw, 1.1rem);
    font-weight: 800;
    color: #FFFFFF;
    background-color: var(--color-primary-pink);
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 0 var(--color-border-strong);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease-spring), background-color var(--duration-fast) var(--ease-standard);
    touch-action: manipulation;
  }

  :global(.btn-reg-submit:hover:not(:disabled)) {
    transform: translateY(-3px);
    box-shadow: 0 7px 0 var(--color-border-strong);
    background-color: #E6002B;
  }

  :global(.btn-reg-submit:active:not(:disabled)) {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--color-border-strong);
  }

  :global(.btn-reg-submit:disabled) {
    opacity: 0.85;
    cursor: not-allowed;
  }

  :global(.submit-content) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.loading-spinner-wrap) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.loading-dot) {
    width: 8px;
    height: 8px;
    background-color: #FFFFFF;
    border-radius: 50%;
    animation: dot-pulse 1.2s infinite ease-in-out;
  }

  :global(.dot-2) { animation-delay: 0.2s; }
  :global(.dot-3) { animation-delay: 0.4s; }

  @keyframes dot-pulse {
    0%, 80%, 100% { transform: scale(0); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
  }

  :global(.form-footer-hint) {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.4;
  }

  :global(.reg-error-alert) {
    background-color: #FFF0F2;
    border: 1.5px solid #FFCCD7;
    border-radius: var(--radius-md);
    padding: 0.85rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-red);
  }

  /* Success Ticket Stub */
  :global(.reg-success-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 0.5rem 0;
  }

  :global(.reg-success-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    background-color: #DCFCE7;
    border: 1.5px solid #86EFAC;
    border-radius: var(--radius-pill);
  }

  :global(.success-kicker) {
    font-family: var(--font-family-display);
    font-size: 0.8rem;
    font-weight: 800;
    color: #15803D;
    letter-spacing: 0.06em;
  }

  :global(.success-heading) {
    font-size: clamp(1.35rem, 3vw, 2rem);
    color: var(--color-text-dark);
  }

  :global(.success-body) {
    max-width: 520px;
    font-size: 0.925rem;
    color: var(--color-text-body);
  }

  :global(.ticket-stub) {
    width: 100%;
    background: radial-gradient(circle at 100% 50%, transparent 12px, #FFF9EB 13px);
    border: 2px dashed #FFD166;
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-subtle);
  }

  :global(.ticket-header) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 209, 102, 0.5);
  }

  :global(.ticket-logo) {
    font-family: var(--font-family-display);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--color-text-dark);
  }

  :global(.ticket-tag) {
    font-family: var(--font-family-mono);
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    background-color: var(--color-primary-pink);
    color: #FFFFFF;
    border-radius: var(--radius-pill);
  }

  :global(.ticket-body) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    text-align: left;
  }

  :global(.ticket-field) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  :global(.ticket-label) {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
  }

  :global(.ticket-val) {
    font-family: var(--font-family-display);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-text-dark);
  }

  :global(.ticket-val.mono) {
    font-family: var(--font-family-mono);
    color: var(--color-red);
  }

  :global(.success-actions-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  :global(.btn-discord) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 1.5rem;
    background-color: #5865F2;
    color: #FFFFFF;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-family-display);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 3px 0 var(--color-border-strong);
    transition: transform var(--duration-fast) var(--ease-spring);
    width: 100%;
  }

  @media (min-width: 480px) {
    :global(.btn-discord) {
      width: auto;
    }
  }

  :global(.btn-discord:hover) {
    transform: translateY(-2px);
  }

  :global(.btn-subtle) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 1.25rem;
    background-color: var(--color-bg);
    color: var(--color-text-dark);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-family-display);
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
    width: 100%;
  }

  @media (min-width: 480px) {
    :global(.btn-subtle) {
      width: auto;
    }
  }

  :global(.btn-subtle:hover) {
    background-color: var(--color-surface);
  }
</style>
