---
import { EVENT_DETAILS } from '@/data/event';
import Pill from '@/components/ui/Pill.astro';
import Sticker from '@/components/ui/Sticker.astro';
import Icon from '@/components/ui/Icon.astro';
---

<section id="about" class="section section-about-overview" aria-label="About the Hackathon">
  <div class="container">
    <!-- Section Kicker & Header -->
    <div class="section-heading-wrap" data-reveal="fade">
      <Pill variant="pink">
        <Icon name="sparkle" size={14} color="var(--color-primary-pink)" />
        <span>About The Hackathon</span>
      </Pill>
      <h2 class="type-section-title section-main-title">
        {EVENT_DETAILS.headline}
      </h2>
      <p class="type-body-lead section-intro-text">
        {EVENT_DETAILS.summary}
      </p>
    </div>

    <!-- Quick Answers Matrix Banner -->
    <div class="quick-facts-banner" data-reveal="slide">
      <div class="grid-4 facts-grid">
        {EVENT_DETAILS.quickFacts.map((fact) => (
          <div class="fact-card">
            <div class="fact-icon-wrap">
              <Icon name={fact.icon} size={22} color="var(--color-primary-pink)" />
            </div>
            <div class="fact-content">
              <span class="type-label">{fact.label}</span>
              <span class="fact-value">{fact.value}</span>
              {fact.badge && <span class="fact-badge">{fact.badge}</span>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Two-Column Asymmetric Deep Dive (Eligibility & Team Structure) -->
    <div class="grid-editorial about-details-grid">
      <!-- Left: Who Can Participate -->
      <div class="about-eligibility-col" data-reveal="slide">
        <div class="col-header">
          <Sticker variant="cream" rotation="neg-2">
            <Icon name="users" size={16} color="var(--color-text-dark)" />
            <span>Who Can Join?</span>
          </Sticker>
          <h3 class="type-subheading col-title">Open to Builders Everywhere</h3>
        </div>

        <div class="eligibility-cards-stack" data-reveal-stagger>
          {EVENT_DETAILS.eligibility.map((item) => (
            <div class="eligibility-card">
              <div class="eligibility-icon-bullet">
                <Icon name={item.icon} size={18} color="var(--color-primary-pink)" />
              </div>
              <div class="eligibility-card-body">
                <h4 class="eligibility-card-title">{item.title}</h4>
                <p class="type-body eligibility-card-desc">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Team Size & Community Lore Frame -->
      <div class="about-team-col" data-reveal="scale">
        <div class="team-lore-frame">
          <div class="lore-pattern-bg"></div>

          <div class="frame-sticker-top">
            <Sticker variant="yellow" rotation="pos-3">
              <Icon name="heart" size={16} color="var(--color-primary-pink)" />
              <span>Small Gift, Big Smile</span>
            </Sticker>
          </div>

          <div class="team-lore-body">
            <div class="team-icon-circle">
              <Icon name="bow" size={32} color="var(--color-red)" />
            </div>

            <h3 class="type-subheading team-frame-title">Team Size: 2 to 4 Members</h3>
            <p class="type-body team-frame-desc">
              {EVENT_DETAILS.teamRequirements.description}
            </p>

            <div class="team-perks-list">
              <div class="perk-pill">
                <Icon name="sparkle" size={14} color="#946800" />
                <span>Automated Team Matcher</span>
              </div>
              <div class="perk-pill">
                <Icon name="terminal" size={14} color="var(--color-blue)" />
                <span>Cross-Discipline Collabs</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-about-overview {
    background-color: var(--color-bg);
    border-top: 1.5px solid var(--color-border);
  }

  .section-heading-wrap {
    max-width: 820px;
    margin: 0 auto var(--space-2xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .section-main-title {
    margin-top: 0.5rem;
  }

  .section-intro-text {
    max-width: 680px;
    margin-top: var(--space-xs);
  }

  /* Quick Facts Banner */
  .quick-facts-banner {
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-3xl);
  }

  .facts-grid {
    gap: 1.25rem;
  }

  .fact-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.75rem 0.5rem;
  }

  .fact-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .fact-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .fact-value {
    font-family: var(--font-family-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-text-dark);
  }

  .fact-badge {
    display: inline-block;
    width: fit-content;
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-primary-pink);
    background-color: var(--color-primary-pink-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    margin-top: 0.2rem;
  }

  /* Editorial Grid Deep Dive */
  .about-details-grid {
    margin-top: var(--space-xl);
    align-items: stretch;
  }

  .about-eligibility-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .col-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .col-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
  }

  .eligibility-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .eligibility-card {
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: transform var(--duration-fast) var(--ease-spring), border-color var(--duration-fast) var(--ease-standard);
  }

  .eligibility-card:hover {
    transform: translateX(6px);
    border-color: var(--color-text-dark);
  }

  .eligibility-icon-bullet {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary-pink-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .eligibility-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .eligibility-card-title {
    font-family: var(--font-family-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text-dark);
  }

  .eligibility-card-desc {
    font-size: 0.925rem;
    color: var(--color-text-muted);
  }

  /* Team Lore Column */
  .about-team-col {
    display: flex;
  }

  .team-lore-frame {
    position: relative;
    width: 100%;
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--shadow-card);
    overflow: visible;
  }

  .lore-pattern-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/textures/subtle-dots-pattern.svg');
    opacity: 0.3;
    border-radius: var(--radius-xl);
  }

  .frame-sticker-top {
    position: absolute;
    top: -16px;
    right: 24px;
    z-index: 2;
  }

  .team-lore-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .team-icon-circle {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-pill);
    background-color: var(--color-red-subtle);
    border: 1.5px solid #FFCCD7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .team-frame-title {
    font-size: 1.45rem;
  }

  .team-frame-desc {
    max-width: 440px;
  }

  .team-perks-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .perk-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-family-display);
    font-size: 0.825rem;
    font-weight: 700;
  }
</style>
